[Unit]
Description=Tarea de Castigo Backend
After=network.target postgresql.service

[Service]
User=lucio
Group=lucio
WorkingDirectory=/home/lucio/Proyectos/tareaDeCastigo/backend
Environment="PATH=/home/lucio/Proyectos/tareaDeCastigo/backend/venv/bin"
# Las fechas límite se comparan con date.today(); el servidor está en UTC
Environment="TZ=America/Mexico_City"
ExecStart=/home/lucio/Proyectos/tareaDeCastigo/backend/venv/bin/gunicorn main:app -w 4 -k uvicorn.workers.UvicornWorker -b 127.0.0.1:8004
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
